# Copy to copilot/.env locally. Never commit the real file.
# Preferred fast backend for 3V0L
LLM_PRIMARY=cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_URL=https://api.cerebras.ai/v1/chat/completions

# Requesty fallback
REQUESTY_API_KEY=
REQUESTY_MODEL=openai/gpt-4o-mini
REQUESTY_URL=https://router.requesty.ai/v1/chat/completions

ANSWER_LANGUAGE=fr
REMOTE_PIN=3060
COPILOT_HOST=0.0.0.0
COPILOT_PORT=38471

# Realtime speech-to-text
AUDIO_ENABLED=1
AUDIO_HOST=0.0.0.0
AUDIO_PORT=38472
AUDIO_SAMPLE_RATE=48000
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Azure Speech fallback/provider. Region for your existing resource is eastus.
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_KEY=
AZURE_SPEECH_LANGUAGE=en-US
